# Copy to .env.local. Never commit actual secrets.
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
DATABASE_URL=postgresql://comsflow:CHANGE_ME@127.0.0.1:5433/comsflow
SESSION_SECRET=
PUBLIC_URL=http://localhost:5173
# Development login is explicitly opt-in, loopback only, and forbidden in production.
DEV_AUTH=false
LARK_APP_ID=
LARK_APP_SECRET=
LARK_TENANT_KEY=
# Optional: defaults to PUBLIC_URL + /auth/callback. Must exactly match that URL.
LARK_REDIRECT_URI=
# Optional scopes explicitly approved in Lark Console, separated by spaces.
LARK_OAUTH_SCOPES=
LARK_BASE_APP_TOKEN=
LARK_BASE_TABLE_ID=

# Optional receiving-slip OCR. Server only; never use a VITE_ prefix.
# Images are sent to OpenAI only after explicit per-slip consent + Read action.
INCOMING_OCR_API_KEY=
INCOMING_OCR_MODEL=gpt-4.1-mini
