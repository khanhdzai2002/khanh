{
  log default {
    format filter {
      wrap json
      fields {
        request>uri query {
          replace code REDACTED
          replace state REDACTED
          replace access_token REDACTED
        }
      }
    }
  }
}

{$APP_DOMAIN} {
  encode zstd gzip
  request_body {
    max_size 16MB
  }
  reverse_proxy app:3001
  # Access logging is deliberately not enabled: OAuth callbacks contain one-use codes.
}
