# Names/reference expressions for Railway Variables, not a local runnable env file.
# Create the PostgreSQL service named Postgres first; adjust its name if different.
DATABASE_URL=${{Postgres.DATABASE_URL}}
NODE_ENV=production
DEV_AUTH=false
HOST=0.0.0.0
# Railway injects PORT; do not set it to the development port.
# Generate a public domain first, then paste the actual https URL below.
APP_BASE_URL=
SESSION_SECRET=
# Optional initially; login stays disabled until all three Lark values are supplied.
LARK_APP_ID=
LARK_APP_SECRET=
LARK_TENANT_KEY=
# Leave blank: derived from APP_BASE_URL + /auth/callback.
LARK_REDIRECT_URI=
LARK_OAUTH_SCOPES=

# Optional one-time setup: exact personal Open ID selected by the hosting owner.
# Never auto-promotes on login; selected user confirms in Settings, only if no admin.
LARK_INITIAL_ADMIN_OPEN_ID=

# Optional receiving-slip OCR. Server only; never use a VITE_ prefix.
# Images are sent to OpenAI only after explicit per-slip consent + Read action.
INCOMING_OCR_API_KEY=
INCOMING_OCR_MODEL=gpt-4.1-mini
