# Template only. Copy to .env.production on the real server. Never commit values.
# Legacy VPS/Compose option only. For Railway use .env.railway.example and RAILWAY_DEPLOY.md.
APP_DOMAIN=
PUBLIC_URL=
NODE_ENV=production
HOST=0.0.0.0
PORT=3001
DEV_AUTH=false
SESSION_SECRET=
# Use a random hex password; set the same value in DATABASE_URL (URL-encoded if needed).
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://comsflow:REPLACE_WITH_PASSWORD@postgres:5432/comsflow
LARK_APP_ID=
LARK_APP_SECRET=
LARK_TENANT_KEY=
# Optional; defaults to PUBLIC_URL + /auth/callback.
LARK_REDIRECT_URI=
LARK_OAUTH_SCOPES=
LARK_BASE_APP_TOKEN=
LARK_BASE_TABLE_ID=

# Optional receiving-slip OCR. Server only; never use a VITE_ prefix.
# Images are sent only to the selected provider after per-slip consent + Read.
INCOMING_OCR_API_KEY=
INCOMING_OCR_MODEL=gpt-4.1-mini

# Optional Gemini provider. Set INCOMING_OCR_PROVIDER=gemini to select it.
# Blank preserves OpenAI or detects Gemini when only its key is configured.
INCOMING_OCR_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
